<Window x:Class="AIUsage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Intelligence" Icon="Assets/App.ico" Width="1340" Height="890" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgCanvas}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="Meta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="QuotaValueCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable, Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>
        <Style x:Key="ChatQuotaGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="{DynamicResource BgSurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>
        <Style x:Key="ChatTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="14,8" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChatTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChatTab}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9FB0CC"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ProviderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#141C2B"/>
            <Setter Property="Foreground" Value="#DCE5F5"/>
            <Setter Property="BorderBrush" Value="#212D42"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="{DynamicResource InputBg}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource TextMuted}"
                                                      StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,3,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource TrackBg}"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderFg}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="InteractionHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Hacé clic para ordenar. Volvé a hacer clic para invertir el orden."/>
            <Style.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderActiveBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridHeaderActiveFg}"/>
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="{DynamicResource GridHeaderActiveBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource GridHeaderActiveFg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSelected}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CellSurface" Property="Background" Value="{DynamicResource BgSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource BgSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#0C111B" Padding="15,20,15,16" BorderBrush="#1A2438" BorderThickness="0,0,1,0">
            <DockPanel>
                <Button x:Name="ThemeButton" DockPanel.Dock="Bottom" Style="{StaticResource Nav}" Click="ToggleTheme"
                        Foreground="#9FB0CC" BorderBrush="#1E2B42" Content="Tema claro"/>

                <StackPanel>
                    <Grid Margin="4,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#0D9488" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M 0,10 L 4,10 L 7,3 L 11,17 L 15,7 L 17,10 L 21,10"
                                  Width="21" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="AI Usage" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Intelligence" Foreground="#7386A6" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="PROVEEDORES" Foreground="#5C6E8C" FontSize="10" FontWeight="SemiBold" Margin="6,0,0,7"/>
                    <Button x:Name="CodexProviderButton" Style="{StaticResource ProviderButton}" Click="SwitchProvider" Tag="codex">
                        <DockPanel LastChildFill="True">
                            <Ellipse x:Name="CodexStatusDot" DockPanel.Dock="Right" Width="7" Height="7" Fill="#65738A" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Codex" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="CodexSubLabel" Text="Iniciando…" Foreground="#8395B3" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button x:Name="AntigravityProviderButton" Style="{StaticResource ProviderButton}" Click="SwitchProvider" Tag="antigravity" Margin="0,0,0,22">
                        <DockPanel LastChildFill="True">
                            <Ellipse x:Name="AntigravityStatusDot" DockPanel.Dock="Right" Width="7" Height="7" Fill="#65738A" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Antigravity" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock x:Name="AntigravitySubLabel" Text="Iniciando…" Foreground="#8395B3" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="OverviewNav" Style="{StaticResource Nav}" Click="Navigate" Tag="overview" AutomationProperties.Name="Resumen">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Data="M1,1 H7 V7 H1 Z M10,1 H16 V7 H10 Z M1,10 H7 V16 H1 Z M10,10 H16 V16 H10 Z"/>
                            </Viewbox>
                            <TextBlock Text="Resumen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InteractionsNav" Style="{StaticResource Nav}" Click="Navigate" Tag="interactions" AutomationProperties.Name="Prompts">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Data="M1,2 H16 V12 H7 L3,16 V12 H1 Z M5,6 H12 M5,9 H10"/>
                            </Viewbox>
                            <TextBlock Text="Prompts" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AnalyticsNav" Style="{StaticResource Nav}" Click="Navigate" Tag="analytics" AutomationProperties.Name="Análisis">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Data="M2,15 V9 H5 V15 Z M7,15 V5 H10 V15 Z M12,15 V2 H15 V15 Z"/>
                            </Viewbox>
                            <TextBlock Text="Análisis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryNav" Style="{StaticResource Nav}" Click="Navigate" Tag="history" AutomationProperties.Name="Historial">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Data="M1,1 V15 H16 M4,11 L8,7 L11,9 L16,3"/>
                            </Viewbox>
                            <TextBlock Text="Historial" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SourcesNav" Style="{StaticResource Nav}" Click="Navigate" Tag="sources" AutomationProperties.Name="Fuentes y cobertura">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeLineJoin="Round" Data="M2,3 C2,-1 15,-1 15,3 C15,7 2,7 2,3 V13 C2,17 15,17 15,13 V3 M2,8 C2,12 15,12 15,8"/>
                            </Viewbox>
                            <TextBlock Text="Fuentes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,28">
                <!-- Unified Compact Top Bar -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Resumen" FontSize="25" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="1,4,0,0">
                            <Ellipse x:Name="StatusDot" Height="7" Width="7" Fill="#65738A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Status" Text="Preparando…" FontSize="12" Style="{StaticResource Meta}"/>
                            <TextBlock x:Name="ProviderDetail" Style="{StaticResource Meta}" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RefreshButton" Click="Refresh" Content="Actualizar" ToolTip="Consultar ahora"/>
                        <Button x:Name="RecordButton" Click="ToggleRecording" Content="Pausar"
                                Margin="8,0,0,0" ToolTip="Pausar o reanudar el monitoreo automático"/>
                    </StackPanel>
                </Grid>

                <!-- ======================== OVERVIEW PANEL ======================== -->
                <StackPanel x:Name="OverviewPanel">
                    <!-- Row 1: Live Quotas + Estimated Autonomy -->
                    <UniformGrid x:Name="QuotaStrip" Rows="1" Margin="-6,0,-6,18">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="6,0">
                            <StackPanel>
                                <TextBlock x:Name="ShortQuotaTitle" Text="Ventana de 5 horas" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="ShortQuota" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,8" Foreground="{DynamicResource AccentPrimary}"/>
                                <ProgressBar x:Name="ShortBar"/>
                                <TextBlock x:Name="ShortReset" Text="Sin datos" Style="{StaticResource Meta}" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ShortAutonomy" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="6,0">
                            <StackPanel>
                                <TextBlock x:Name="WeekQuotaTitle" Text="Ventana semanal" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="WeekQuota" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,8" Foreground="{DynamicResource AccentSecondary}"/>
                                <ProgressBar x:Name="WeekBar" Foreground="{DynamicResource AccentSecondary}"/>
                                <TextBlock x:Name="WeekReset" Text="Sin datos" Style="{StaticResource Meta}" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock x:Name="WeekAutonomy" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecondary}" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AltQuotaCard1" Visibility="Collapsed" Style="{StaticResource Card}" Padding="16" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Claude / GPT · 5 horas" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="AltShortQuota" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,8" Foreground="{DynamicResource AccentPurple}"/>
                                <ProgressBar x:Name="AltShortBar" Foreground="{DynamicResource AccentPurple}"/>
                                <TextBlock x:Name="AltShortReset" Text="Sin datos" Style="{StaticResource Meta}" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock x:Name="AltShortAutonomy" Style="{StaticResource Meta}" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="AltQuotaCard2" Visibility="Collapsed" Style="{StaticResource Card}" Padding="16" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Claude / GPT · Semanal" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="AltWeekQuota" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,8" Foreground="{DynamicResource AccentAmber}"/>
                                <ProgressBar x:Name="AltWeekBar" Foreground="{DynamicResource AccentAmber}"/>
                                <TextBlock x:Name="AltWeekReset" Text="Sin datos" Style="{StaticResource Meta}" FontSize="11" Margin="0,8,0,0"/>
                                <TextBlock x:Name="AltWeekAutonomy" Style="{StaticResource Meta}" FontSize="11" Margin="0,3,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Quota history preview -->
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="OverviewLegend1" Text="●  5 h" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"/>
                                    <TextBlock x:Name="OverviewLegend2" Text="●  Semanal" Foreground="{DynamicResource AccentSecondary}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="Cuota disponible" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <Grid Height="160">
                                <Canvas x:Name="OverviewChart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                <TextBlock x:Name="OverviewEmpty" Text="Esperando muestras de cuota." Style="{StaticResource Meta}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ======================== PROMPTS (INTERACTIONS) PANEL ======================== -->
                <StackPanel x:Name="InteractionsPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.75*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Proyecto" Style="{StaticResource Meta}" FontSize="11" Margin="2,0,0,4"/>
                            <ComboBox x:Name="ProjectPicker" DisplayMemberPath="Label" SelectionChanged="SelectProject"
                                      ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Chat" Style="{StaticResource Meta}" FontSize="11" Margin="2,0,0,4"/>
                            <ComboBox x:Name="SessionPicker" DisplayMemberPath="Label" SelectionChanged="SelectSession"
                                      ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ChatState" Text="Buscando chats…" Style="{StaticResource Meta}" Margin="0,0,0,8"/>
                    <TabControl x:Name="ChatViewTabs" Style="{StaticResource ChatTabs}" SelectionChanged="SelectChatView">
                        <TabItem Header="Preguntas">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="156"/>
                                        <ColumnDefinition Width="134"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Buscar" Style="{StaticResource Meta}" FontSize="11" Margin="2,0,0,4"/>
                                        <TextBox x:Name="SearchBox" TextChanged="SearchInteractions" ToolTip="Filtrar por texto del prompt o modelo"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Cuota" Style="{StaticResource Meta}" FontSize="11" Margin="2,0,0,4"/>
                                        <ComboBox x:Name="WindowPicker" SelectedIndex="0" SelectionChanged="FilterInteractions">
                                            <ComboBoxItem x:Name="WindowOpt1" Content="5 horas"/>
                                            <ComboBoxItem x:Name="WindowOpt2" Content="Semanal"/>
                                            <ComboBoxItem x:Name="WindowOpt3" Content="Claude/GPT · 5 h" Visibility="Collapsed"/>
                                            <ComboBoxItem x:Name="WindowOpt4" Content="Claude/GPT · Sem." Visibility="Collapsed"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Origen" Style="{StaticResource Meta}" FontSize="11" Margin="2,0,0,4"/>
                                        <ComboBox x:Name="InteractionFilter" SelectedIndex="0" SelectionChanged="FilterInteractions">
                                            <ComboBoxItem Content="Mis prompts"/>
                                            <ComboBoxItem Content="Automáticos"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <DockPanel Margin="0,0,0,8">
                                    <Button x:Name="ResetInteractionSortButton" DockPanel.Dock="Right" Content="Más recientes"
                                            Click="ResetInteractionSort" Visibility="Collapsed" Margin="8,0,0,0" Padding="9,3" FontSize="12"/>
                                    <TextBlock x:Name="InteractionCoverage" Text="Buscando chats locales…"
                                               Style="{StaticResource Meta}" FontSize="12" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource BgSurface}" Padding="1">
                                    <DataGrid x:Name="InteractionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                              SelectionChanged="SelectInteraction" Sorting="SortInteractions" SelectionMode="Single" CanUserAddRows="False"
                                              ColumnHeaderStyle="{StaticResource InteractionHeader}"
                                              Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLine}"
                                              HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="400" RowHeight="37">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Fecha" Binding="{Binding Time}" SortMemberPath="At" Width="1.05*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                        <Setter Property="ToolTip" Value="{Binding TimeHint}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Prompt" Binding="{Binding Label}" SortMemberPath="Label" Width="2.5*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        <Setter Property="ToolTip" Value="{Binding Label}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" SortMemberPath="Model" Width="1.2*"/>
                                            <DataGridTextColumn Header="Inicial" Binding="{Binding Before}" SortMemberPath="Before" Width="0.68*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                        <Setter Property="ToolTip" Value="{Binding BeforeHint}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Última" Binding="{Binding After}" SortMemberPath="After" Width="0.68*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                        <Setter Property="ToolTip" Value="{Binding AfterHint}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Bajó" Binding="{Binding Drop}" SortMemberPath="Drop" Width="0.68*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource QuotaValueCell}">
                                                        <Setter Property="ToolTip" Value="{Binding MeasurementHint}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Pasos" Binding="{Binding Calls}" SortMemberPath="Calls" Width="0.65*"/>
                                            <DataGridTextColumn Header="Medición" Binding="{Binding Measurement}" SortMemberPath="Measurement" Width="0.92*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                        <Setter Property="ToolTip" Value="{Binding MeasurementHint}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Tokens" Binding="{Binding TokensShort}" SortMemberPath="TotalTokens" Width="0.98*"/>
                                            <DataGridTextColumn Header="Costo API" Binding="{Binding CostText}" SortMemberPath="CostUsd" Width="0.82*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                        <Setter Property="ToolTip" Value="{Binding CostHint}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Prompt Detail Inspector -->
                                <Border x:Name="InteractionDetail" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                                    <Expander Header="Detalle del prompt" Foreground="{DynamicResource TextPrimary}">
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock x:Name="InteractionTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                            <WrapPanel x:Name="InteractionChips" Margin="0,8,0,12"/>

                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource BgSurfaceTint}" BorderBrush="{DynamicResource BorderTint}" BorderThickness="1" CornerRadius="10" Padding="13">
                                                    <StackPanel>
                                                        <TextBlock x:Name="ShortImpactTitle" Text="Ventana de 5 horas" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="ShortImpact" Foreground="{DynamicResource AccentPrimary}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                        <TextBlock x:Name="ShortReadings" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock x:Name="ShortExplanation" Style="{StaticResource Meta}" FontSize="11" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="{DynamicResource BgSurfaceMint}" BorderBrush="{DynamicResource BorderMint}" BorderThickness="1" CornerRadius="10" Padding="13">
                                                    <StackPanel>
                                                        <TextBlock x:Name="WeekImpactTitle" Text="Ventana semanal" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="WeekImpact" Foreground="{DynamicResource AccentSecondary}" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                        <TextBlock x:Name="WeekReadings" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock x:Name="WeekExplanation" Style="{StaticResource Meta}" FontSize="11" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <Border Background="{DynamicResource BgSurfaceAlt}" BorderBrush="{DynamicResource BorderSubtle}"
                                                    BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock x:Name="InteractionApiCost" DockPanel.Dock="Right" Style="{StaticResource Meta}" FontSize="12" Margin="10,0,0,0"/>
                                                        <TextBlock x:Name="InteractionTokens" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AccentPrimary}"/>
                                                    </DockPanel>
                                                    <Grid Height="7">
                                                        <Border Background="{DynamicResource TrackBg}" CornerRadius="3.5"/>
                                                        <Grid ClipToBounds="True">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition x:Name="BarInputCol" Width="1*"/>
                                                                <ColumnDefinition x:Name="BarCacheCol" Width="1*"/>
                                                                <ColumnDefinition x:Name="BarOutputCol" Width="1*"/>
                                                                <ColumnDefinition x:Name="BarReasonCol" Width="1*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#4F63E7" CornerRadius="3.5,0,0,3.5"/>
                                                            <Border Grid.Column="1" Background="#14B8A6"/>
                                                            <Border Grid.Column="2" Background="#F59E0B"/>
                                                            <Border Grid.Column="3" Background="#A855F7" CornerRadius="0,3.5,3.5,0"/>
                                                        </Grid>
                                                    </Grid>
                                                    <TextBlock x:Name="InteractionCostBreakdown" Style="{StaticResource Meta}" FontSize="11" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Expander x:Name="CallsExpander" Header="Ver pasos del modelo">
                                                <DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8,0,0"
                                                          CanUserAddRows="False" Background="{DynamicResource BgSurface}" Foreground="{DynamicResource TextPrimary}"
                                                          BorderBrush="{DynamicResource BorderSubtle}" GridLinesVisibility="Horizontal"
                                                          HorizontalGridLinesBrush="{DynamicResource GridLine}" HeadersVisibility="Column"
                                                          RowHeaderWidth="0" MaxHeight="250" RowHeight="31">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Hora" Binding="{Binding Time}" Width="0.8*"/>
                                                        <DataGridTextColumn Header="Tipo de paso" Binding="{Binding Kind}" Width="1.1*">
                                                            <DataGridTextColumn.ElementStyle>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                                                    <Setter Property="ToolTip" Value="{Binding KindHint}"/>
                                                                </Style>
                                                            </DataGridTextColumn.ElementStyle>
                                                        </DataGridTextColumn>
                                                        <DataGridTextColumn Header="Contexto" Binding="{Binding Context}" Width="0.95*"/>
                                                        <DataGridTextColumn Header="Entrada" Binding="{Binding Input}" Width="0.85*"/>
                                                        <DataGridTextColumn Header="Caché" Binding="{Binding Cache}" Width="0.95*"/>
                                                        <DataGridTextColumn Header="Salida" Binding="{Binding Output}" Width="0.85*"/>
                                                        <DataGridTextColumn Header="Razonam." Binding="{Binding Reasoning}" Width="0.85*"/>
                                                        <DataGridTextColumn Header="Costo API" Binding="{Binding Cost}" Width="0.85*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Cuota del chat">
                            <StackPanel>
                                <Border x:Name="SessionQuotaCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="14,11" Margin="0,0,0,12"
                                        ToolTip="Los cambios de cuota compartidos quedan fuera de la suma.">
                                    <StackPanel>
                                        <TextBlock Text="Acumulado semanal" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="SessionQuotaWeeksEmpty" Text="Todavía no hay lecturas de la ventana semanal." Style="{StaticResource Meta}"/>
                                        <DataGrid x:Name="SessionQuotaWeeks" Style="{StaticResource ChatQuotaGrid}" MaxHeight="126">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Semana de cuota" Binding="{Binding Range}" Width="2.5*"/>
                                                <DataGridTextColumn x:Name="SessionQuotaWeekPool" Header="Cuota de" Binding="{Binding Pool}" Width="*"/>
                                                <DataGridTextColumn Header="Bajó en el chat" Binding="{Binding Drop}" Width="*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                                <DataGridTextColumn Header="Medición" Binding="{Binding Coverage}" Width="1.5*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Bloques de 5 horas" Style="{StaticResource CardTitle}" Margin="0,16,0,6"/>
                                        <TextBlock x:Name="SessionQuotaBlocksEmpty" Text="Todavía no hay bloques registrados con actividad de este chat." Style="{StaticResource Meta}"/>
                                        <DataGrid x:Name="SessionQuotaBlocks" Style="{StaticResource ChatQuotaGrid}" MaxHeight="190">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Bloque (hora local)" Binding="{Binding Range}" Width="2.5*"/>
                                                <DataGridTextColumn x:Name="SessionQuotaBlockPool" Header="Cuota de" Binding="{Binding Pool}" Width="*"/>
                                                <DataGridTextColumn Header="Bajó en 5 h" Binding="{Binding Drop}" Width="*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                                <DataGridTextColumn Header="Bajó de la semanal" Binding="{Binding WeekDrop}" Width="1.25*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource QuotaValueCell}">
                                                            <Setter Property="ToolTip" Value="{Binding WeekHint}"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Medición de 5 h" Binding="{Binding Coverage}" Width="1.5*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Modelos">
                            <StackPanel>
                                <Border x:Name="SessionComparisonCard" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid x:Name="SessionCompChartPanel" Height="125" Margin="0,0,0,10">
                                            <Canvas x:Name="SessionCompChart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                            <TextBlock x:Name="SessionCompEmpty" Text="Sin datos comparables en este chat." Style="{StaticResource Meta}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataGrid x:Name="SessionCompGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                                  Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderSubtle}"
                                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLine}"
                                                  HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="190" RowHeight="31">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="1.45*"/>
                                                <DataGridTextColumn Header="Esfuerzo" Binding="{Binding Effort}" Width="0.88*"/>
                                                <DataGridTextColumn Header="Prompts" Binding="{Binding Turns}" Width="0.68*"/>
                                                <DataGridTextColumn Header="Pasos/prompt" Binding="{Binding AvgSteps}" Width="0.85*"/>
                                                <DataGridTextColumn Header="Caché" Binding="{Binding Cache}" Width="0.68*"/>
                                                <DataGridTextColumn Header="Costo API" Binding="{Binding Cost}" Width="0.82*"/>
                                                <DataGridTextColumn Header="$/prompt" Binding="{Binding AvgTurn}" Width="0.82*"/>
                                                <DataGridTextColumn Header="5 h / prompt" Binding="{Binding Drop5h}" Width="0.88*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                                <DataGridTextColumn Header="Sem. / prompt" Binding="{Binding DropWeek}" Width="0.9*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="SessionComparisonEmpty" Text="Sin datos de modelos para este chat." Style="{StaticResource Meta}" Margin="2,4"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>

                <!-- ======================== ANALYTICS PANEL ======================== -->
                <StackPanel x:Name="AnalyticsPanel" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,14">
                        <Border DockPanel.Dock="Right" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="9" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AnPeriod24hBtn" Style="{StaticResource SegmentButton}" Content="24 horas" Tag="24h" Click="SelectPeriod"/>
                                <Button x:Name="AnPeriod7dBtn" Style="{StaticResource SegmentButton}" Content="7 días" Tag="7d" Click="SelectPeriod"/>
                                <Button x:Name="AnPeriod30dBtn" Style="{StaticResource SegmentButton}" Content="30 días" Tag="30d" Click="SelectPeriod"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AnalyticsCoverage" Style="{StaticResource Meta}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 1: Averages per Chat & per Prompt -->
                    <UniformGrid Columns="4" Margin="-6,0,-6,16">
                        <Border Style="{StaticResource Card}" Background="{DynamicResource BgSurfaceTint}" BorderBrush="{DynamicResource BorderTint}" Padding="15" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Cuota 5 h prom. / chat" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="Avg5hSessionValue" Text="—" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentPrimary}"/>
                                <TextBlock x:Name="Avg5hTurnSub" Text="Sin prompts con cuota medida" Style="{StaticResource Meta}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Background="{DynamicResource BgSurfaceMint}" BorderBrush="{DynamicResource BorderMint}" Padding="15" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Cuota Semanal prom. / chat" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="AvgWeekSessionValue" Text="—" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentSecondary}"/>
                                <TextBlock x:Name="AvgWeekTurnSub" Text="Sin muestras semanales" Style="{StaticResource Meta}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="15" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Costo API prom. / chat" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="AvgCostSessionValue" Text="—" Style="{StaticResource KpiValue}"/>
                                <TextBlock x:Name="AvgCostSessionSub" Text="—" Style="{StaticResource Meta}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="15" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Costo API prom. / prompt" Style="{StaticResource Meta}" FontSize="12"/>
                                <TextBlock x:Name="AvgCostTurnValue" Text="—" Style="{StaticResource KpiValue}"/>
                                <TextBlock x:Name="AvgCostTurnSub" Text="—" Style="{StaticResource Meta}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <Expander Header="Tamaño del chat y esfuerzo" Foreground="{DynamicResource TextPrimary}" Expanded="ExpandAnalyticsSection">
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Costo según el tamaño del chat" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="ContextImpactInsight" Style="{StaticResource Meta}" FontSize="11.5" Margin="0,3,0,10"/>
                                        <Grid Height="185">
                                            <Canvas x:Name="ContextImpactChart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                            <TextBlock x:Name="ContextImpactEmpty" Text="Sin suficientes prompts tarifados." Style="{StaticResource Meta}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Costo por nivel de esfuerzo" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="EffortImpactInsight" Style="{StaticResource Meta}" FontSize="11.5" Margin="0,3,0,10"/>
                                        <Grid Height="185">
                                            <Canvas x:Name="EffortImpactChart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                            <TextBlock x:Name="EffortImpactEmpty" Text="Sin niveles de esfuerzo registrados." Style="{StaticResource Meta}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <Expander Header="Modelos y esfuerzo" Foreground="{DynamicResource TextPrimary}" Expanded="ExpandAnalyticsSection">
                            <StackPanel Margin="0,12,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BgSurfaceAlt}" BorderBrush="{DynamicResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="8" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="MetricDrop5hBtn" Style="{StaticResource SegmentButton}" Content="5 h / prompt" Tag="drop5h" Click="SelectComparisonMetric" Padding="11,4"/>
                                            <Button x:Name="MetricDropWeekBtn" Style="{StaticResource SegmentButton}" Content="Semanal / prompt" Tag="dropWeek" Click="SelectComparisonMetric" Padding="11,4"/>
                                            <Button x:Name="MetricAvgTurnBtn" Style="{StaticResource SegmentButton}" Content="$/prompt" Tag="avgTurn" Click="SelectComparisonMetric" Padding="11,4"/>
                                            <Button x:Name="MetricUsdBtn" Style="{StaticResource SegmentButton}" Content="Costo total" Tag="usd" Click="SelectComparisonMetric" Padding="11,4"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <Grid Height="215" Margin="0,0,0,12">
                                    <Canvas x:Name="ModelComparisonChart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                    <TextBlock x:Name="ModelComparisonEmpty" Text="Sin datos suficientes para esta métrica en el período seleccionado."
                                               Style="{StaticResource Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <DataGrid x:Name="ModelEffortGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderSubtle}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLine}"
                                          HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="300" RowHeight="33">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="1.45*"/>
                                        <DataGridTextColumn Header="Esfuerzo" Binding="{Binding Effort}" Width="0.9*"/>
                                        <DataGridTextColumn Header="Prompts" Binding="{Binding Turns}" Width="0.68*"/>
                                        <DataGridTextColumn Header="Pasos/prompt" Binding="{Binding AvgSteps}" Width="0.88*"/>
                                        <DataGridTextColumn Header="5 h / prompt" Binding="{Binding Drop5h}" Width="0.95*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                        <DataGridTextColumn Header="Sem. / prompt" Binding="{Binding DropWeek}" Width="0.98*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                        <DataGridTextColumn Header="Caché" Binding="{Binding Cache}" Width="0.68*"/>
                                        <DataGridTextColumn Header="Costo API" Binding="{Binding Cost}" Width="0.85*"/>
                                        <DataGridTextColumn Header="$/prompt" Binding="{Binding AvgTurn}" Width="0.85*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Expander>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                        <Expander Header="Costos y actividad" Foreground="{DynamicResource TextPrimary}" Expanded="ExpandAnalyticsSection">
                            <StackPanel Margin="0,12,0,0">
                                <UniformGrid Columns="4" Margin="-6,0,-6,16">
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource BgSurfaceTint}" BorderBrush="{DynamicResource BorderTint}" Padding="15" Margin="6,0">
                                        <StackPanel>
                                            <TextBlock Text="Equivalente API" Style="{StaticResource Meta}" FontSize="12"/>
                                            <TextBlock x:Name="ApiCostValue" Text="—" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentPrimary}"/>
                                            <TextBlock x:Name="ApiCostSub" Text="Entrada · Caché · Salida" Style="{StaticResource Meta}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="QuotaRateCard" Style="{StaticResource Card}" Padding="15" Margin="6,0"
                                            ToolTip="Calibrado empíricamente con prompts aislados de tu cuenta y plan actual (sin asumir multiplicadores fijos).">
                                        <StackPanel>
                                            <TextBlock x:Name="QuotaRateTitle" Text="1 % de cuota 5 h (tu plan)" Style="{StaticResource Meta}" FontSize="12"/>
                                            <TextBlock x:Name="QuotaRateValue" Text="—" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentPurple}"/>
                                            <TextBlock x:Name="QuotaRateSub" Text="Calibrando con prompts medidos…" Style="{StaticResource Meta}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource BgSurfaceMint}" BorderBrush="{DynamicResource BorderMint}" Padding="15" Margin="6,0">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="CacheHitRateLabel" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSecondary}"/>
                                                <TextBlock Text="Ahorro por caché" Style="{StaticResource Meta}" FontSize="12"/>
                                            </DockPanel>
                                            <TextBlock x:Name="CacheSavingsValue" Text="—" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentSecondary}"/>
                                            <ProgressBar x:Name="CacheHitBar" Foreground="{DynamicResource AccentSecondary}" Height="5" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Padding="15" Margin="6,0">
                                        <StackPanel>
                                            <TextBlock Text="Ritmo por prompt" Style="{StaticResource Meta}" FontSize="12"/>
                                            <TextBlock x:Name="PaceValue" Text="—" Style="{StaticResource KpiValue}"/>
                                            <TextBlock x:Name="PaceSub" Text="—" Style="{StaticResource Meta}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="Prompts de mayor costo" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
                                            <StackPanel x:Name="TopPromptsPanel"/>
                                            <TextBlock x:Name="TopPromptsEmpty" Text="Sin prompts registrados en este período." Style="{StaticResource Meta}" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="Gasto por modelo" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
                                            <StackPanel x:Name="ModelBreakdownPanel"/>
                                            <TextBlock x:Name="ModelBreakdownEmpty" Text="Sin modelos registrados en este período." Style="{StaticResource Meta}" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <TextBlock Text="Chats más pesados" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
                                            <StackPanel x:Name="HeavyChatsPanel"/>
                                            <TextBlock x:Name="HeavyChatsEmpty" Text="Sin chats registrados en este período." Style="{StaticResource Meta}" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DailyTrendCard" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="CostChartSub" DockPanel.Dock="Right" Style="{StaticResource Meta}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="CostChartTitle" Text="Tendencia diaria de gasto API" Style="{StaticResource CardTitle}"/>
                                            </DockPanel>
                                            <Grid Height="185">
                                                <Canvas x:Name="CostBarChart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                                <TextBlock x:Name="CostBarEmpty" Text="Seleccioná 7 días o 30 días para ver la tendencia diaria." Style="{StaticResource Meta}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>

                <!-- ======================== HISTORY PANEL ======================== -->
                <StackPanel x:Name="HistoryPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,15">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock x:Name="HistoryLegend1" Text="●  5 horas" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"/>
                                    <TextBlock x:Name="HistoryLegend2" Text="●  Semanal" Foreground="{DynamicResource AccentSecondary}" FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="Evolución histórica de cuota (%)" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <Grid Height="220">
                                <Canvas x:Name="Chart" SizeChanged="ChartSizeChanged" ClipToBounds="True"/>
                                <TextBlock x:Name="ChartEmpty" Text="Las muestras aparecerán después de la primera lectura."
                                           Style="{StaticResource Meta}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource BgSurface}" Padding="1">
                        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="Transparent"
                                  Foreground="{DynamicResource TextPrimary}" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource GridLine}" HeadersVisibility="Column" RowHeaderWidth="0"
                                  CanUserAddRows="False" MaxHeight="380" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Captura" Binding="{Binding Time}" Width="1.3*"/>
                                <DataGridTextColumn x:Name="HistoryCol1" Header="5 h disponible" Binding="{Binding Short}" Width="*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                <DataGridTextColumn Header="Δ 5 h" Binding="{Binding Delta}" Width="0.8*"/>
                                <DataGridTextColumn x:Name="HistoryCol2" Header="Semanal disponible" Binding="{Binding Week}" Width="*" ElementStyle="{StaticResource QuotaValueCell}"/>
                                <DataGridTextColumn Header="Origen" Binding="{Binding Storage}" Width="1.2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <!-- ======================== SOURCES PANEL ======================== -->
                <StackPanel x:Name="SourcesPanel" Visibility="Collapsed">
                    <Button Click="OpenRecordings" Content="Abrir grabaciones" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Medición de cuota" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Los porcentajes vienen de lecturas del proveedor. La tabla identifica mediciones parciales o compartidas." Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                            <TextBlock Text="Los rangos de prompts restantes usan tu historial local de bajas medibles." Style="{StaticResource Meta}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="2" Margin="-7,0,-7,14">
                        <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                            <StackPanel>
                                <TextBlock x:Name="OfficialSourceTitle" Text="Cuota oficial" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="OfficialDetail" Text="Esperando primera lectura." Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="ExtraWindows" Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,7,14">
                            <StackPanel>
                                <TextBlock x:Name="LocalSourceTitle" Text="Historial local" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="LocalDetail" Text="Esperando lectura del historial." Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <TextBlock Text="Tarifas API" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="PricingSourceDetail" Text="Tarifas oficiales integradas + sincronización automática cada 24 h." Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0">
                            <StackPanel>
                                <TextBlock x:Name="ComparisonTitle" Text="Verificación y privacidad" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Comparison" Text="—" Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="Attribution" Style="{StaticResource Meta}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Expander Header="Glosario" Foreground="{DynamicResource TextPrimary}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Chat · Conversación completa." Style="{StaticResource Meta}"/>
                                <TextBlock Text="Prompt · Un envío tuyo. La actividad automática aparece como otro origen." Style="{StaticResource Meta}"/>
                                <TextBlock Text="Paso del modelo · Una llamada al modelo, inicial, de seguimiento o de un subagente." Style="{StaticResource Meta}"/>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
